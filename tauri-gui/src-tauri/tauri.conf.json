{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaxonDBBuilder",
  "version": "3.3.1",
  "identifier": "com.taxondb.builder.gui",
  "build": {
    "beforeDevCommand": "npm run build:sidecar && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TaxonDBBuilder",
        "width": 1320,
        "height": 920,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["bin/taxondbbuilder"],
    "icon": ["icons/icon.png"]
  }
}
